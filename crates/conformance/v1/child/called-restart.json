{
  "version": 1,
  "name": "called-restart",
  "about": "A thing is not done twice because a process died. The shell wrote the call down before doing it and keeps it until the session says her host has the result (call_settled). The process goes after the result was handed in and before her host acked it; the session made anew knows nothing of the call. The shell hands in what its disk still holds before it connects: the call is answered as not known, and when her host asks again it is answered the same, never handed to the shell again.",
  "capabilities": ["calls"],
  "offers": [{"name": "screen.look", "version": 1}],
  "steps": [
    {"at": 0, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 50, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"at": 60, "host": {"t": "call.granted", "body": {"actions": [{"name": "screen.look", "version": 1}], "providing": []}}},
    {"deliver": {"kind": "granted"}},
    {"at": 1000, "host": {"t": "call.ask", "id": "call_1", "body": {"callId": "call_1", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760140810000}}},
    {"child": {"t": "ack"}},
    {"deliver": {"kind": "call", "callId": "call_1"}},
    {"at": 1500, "do": {"callDone": {"callId": "call_1", "result": {"facts": {"app": "Xcode"}}}}},
    {"child": {"t": "call.result", "id": "call_1.result"}},
    {"at": 2000, "do": "restart"},
    {"at": 2100, "do": {"callsLost": [{"callId": "call_1", "action": "screen.look", "version": 1}]}},
    {"at": 3000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 3050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760140803050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"child": {"t": "call.result", "id": "call_1.result", "body": {"callId": "call_1", "action": "screen.look", "version": 1, "outcome": "unknown"}}},
    {"at": 3060, "host": {"t": "call.granted", "body": {"actions": [{"name": "screen.look", "version": 1}], "providing": []}}},
    {"deliver": {"kind": "call_settled", "callId": "call_1"}},
    {"deliver": {"kind": "granted"}},
    {"at": 3100, "host": {"t": "call.ask", "id": "call_1", "body": {"callId": "call_1", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760140810000}}},
    {"child": {"t": "ack"}},
    {"child": {"t": "call.result", "id": "call_1.result", "body": {"callId": "call_1", "action": "screen.look", "version": 1, "outcome": "unknown"}}},
    {"at": 3200, "host": {"t": "ping"}},
    {"deliver": {"kind": "call_settled", "callId": "call_1"}},
    {"child": {"t": "pong"}}
  ]
}

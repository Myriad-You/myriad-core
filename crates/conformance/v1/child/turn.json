{
  "version": 1,
  "name": "turn",
  "about": "What the owner says goes up once as a reliable input whose id is the turn; the run's events come in run sequence and one already taken is not delivered again. After a reconnect the child asks for what it missed of an unfinished turn (run.resume after its last sequence). An input the host did not ack goes again with the same id; when the host already had it (duplicate), the child asks for the run from where it is. One the host acked and never answered is not sent again: the child asks for it by its turn alone, and a host that does not have it rejects it, so the owner is told it was not sent.",
  "capabilities": [],
  "steps": [
    {"at": 0, "do": "connect"},
    {"child": {"t": "hello", "seq": 1, "ack": 0, "body": {"protocol": 2, "role": "child", "surface": "app", "capabilities": []}}},
    {"at": 50, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": [], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome", "deviceId": "dev_0123456789abcdef0123456789abcdef", "host": "site"}},
    {"at": 1000, "do": {"say": {"turnId": "t_02", "text": "今天过得怎么样？", "sessionId": "sess_1"}}},
    {"child": {"t": "input", "id": "t_02", "seq": 2, "ack": 1, "body": {"surface": "app", "text": "今天过得怎么样？", "sessionId": "sess_1"}}},
    {"at": 1020, "host": {"t": "run.accepted", "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "sessionId": "sess_1", "duplicate": false}}},
    {"deliver": {"kind": "accepted", "turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "duplicate": false}},
    {"at": 1100, "host": {"t": "run.event", "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "sequence": 1, "event": {"type": "summary_token", "token": "还", "done": false}}}},
    {"deliver": {"kind": "event", "turnId": "t_02", "sequence": 1}},
    {"at": 1200, "host": {"t": "run.event", "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "sequence": 2, "event": {"type": "summary_token", "token": "不错", "done": false}}}},
    {"deliver": {"kind": "event", "sequence": 2, "event": {"token": "不错"}}},
    {"at": 1250, "host": {"t": "run.event", "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "sequence": 2, "event": {"type": "summary_token", "token": "不错", "done": false}}}},
    {"at": 1300, "do": "disconnect"},
    {"at": 5000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 5050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": [], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "run.resume", "seq": 2, "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "afterSeq": 2}}},
    {"at": 5100, "host": {"t": "run.event", "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "sequence": 3, "event": {"type": "summary_token", "token": "。", "done": false}}}},
    {"deliver": {"kind": "event", "sequence": 3}},
    {"at": 5200, "host": {"t": "run.end", "body": {"turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210", "lastSequence": 3}}},
    {"deliver": {"kind": "end", "turnId": "t_02", "runId": "run_fedcba9876543210fedcba9876543210"}},
    {"at": 6000, "do": {"say": {"turnId": "t_03", "text": "在吗"}}},
    {"child": {"t": "input", "id": "t_03", "seq": 3}},
    {"at": 6100, "do": "disconnect"},
    {"at": 8000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 8050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": [], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "input", "id": "t_03", "seq": 2, "body": {"text": "在吗"}}},
    {"at": 8100, "host": {"t": "run.accepted", "body": {"turnId": "t_03", "runId": "run_03", "duplicate": true}}},
    {"deliver": {"kind": "accepted", "turnId": "t_03", "runId": "run_03", "duplicate": true}},
    {"child": {"t": "run.resume", "seq": 3, "body": {"turnId": "t_03", "runId": "run_03", "afterSeq": 0}}},
    {"at": 8200, "host": {"t": "run.end", "body": {"turnId": "t_03", "runId": "run_03", "lastSequence": 0}}},
    {"deliver": {"kind": "end", "turnId": "t_03", "runId": "run_03"}},
    {"at": 9000, "do": {"say": {"turnId": "t_04", "text": "还在吗"}}},
    {"child": {"t": "input", "id": "t_04", "seq": 4, "ack": 3}},
    {"at": 9010, "host": {"t": "ping"}},
    {"child": {"t": "pong", "seq": 5, "ack": 4}},
    {"at": 9100, "do": "disconnect"},
    {"at": 12000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 12050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": [], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "run.resume", "seq": 2, "ack": 1, "body": {"turnId": "t_04", "afterSeq": 0, "runId": "$absent"}}},
    {"at": 12100, "host": {"t": "run.rejected", "body": {"turnId": "t_04", "code": "turn_unknown"}}},
    {"deliver": {"kind": "rejected", "turnId": "t_04", "code": "turn_unknown"}}
  ]
}

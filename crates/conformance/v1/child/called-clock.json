{
  "version": 1,
  "name": "called-clock",
  "about": "A call's deadline is read by her host's clock, which the welcome sets right: here it runs an hour ahead of the time the shell gives. A call in hand is stopped and answered call_timeout the moment that clock reaches its deadline, not before; an ask already past by that clock is not done; and a deadline passes with the link down all the same, its answer waiting for the link.",
  "capabilities": ["calls"],
  "offers": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}],
  "hostAheadMs": 3600000,
  "steps": [
    {"at": 0, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 50, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760144400050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"at": 60, "host": {"t": "call.granted", "body": {"actions": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}], "providing": []}}},
    {"deliver": {"kind": "granted"}},
    {"at": 1000, "host": {"t": "call.ask", "id": "call_look_1", "body": {"callId": "call_look_1", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760144409000}}},
    {"child": {"t": "ack"}},
    {"deliver": {"kind": "call", "callId": "call_look_1", "deadlineAt": 1760144409000}},
    {"at": 8999, "do": "tick"},
    {"at": 9000, "do": "tick"},
    {"deliver": {"kind": "call_stop", "callId": "call_look_1", "why": "timeout"}},
    {"child": {"t": "call.result", "id": "call_look_1.result", "body": {"callId": "call_look_1", "action": "screen.look", "version": 1, "outcome": "failed", "error": {"code": "call_timeout"}}}},
    {"at": 9500, "host": {"t": "call.ask", "id": "call_look_2", "body": {"callId": "call_look_2", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760144409400}}},
    {"child": {"t": "ack"}},
    {"child": {"t": "call.result", "id": "call_look_2.result", "body": {"callId": "call_look_2", "action": "screen.look", "version": 1, "outcome": "failed", "error": {"code": "call_timeout"}}}},
    {"at": 10000, "host": {"t": "call.ask", "id": "call_look_3", "body": {"callId": "call_look_3", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760144412000}}},
    {"child": {"t": "ack"}},
    {"deliver": {"kind": "call", "callId": "call_look_3"}},
    {"at": 11000, "do": "disconnect"},
    {"at": 12000, "do": "tick"},
    {"deliver": {"kind": "call_stop", "callId": "call_look_3", "why": "timeout"}},
    {"at": 20000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 20050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760144420050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"child": {"t": "call.result", "id": "call_look_3.result", "body": {"callId": "call_look_3", "action": "screen.look", "version": 1, "outcome": "failed", "error": {"code": "call_timeout"}}, "seq": 3}}
  ]
}

{
  "version": 1,
  "name": "streams",
  "about": "On a link where both ends listed streams, this end tells the newest value of something that changes (stream.state, let go while the link is down) and things that happened (stream.event, kept until acked, waiting for a link with streams). What her host tells of a name the contract does not register is passed by, an event acked. The report of a dropped frame is the session's own to make, not the shell's.",
  "capabilities": ["streams"],
  "steps": [
    {"at": 0, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 50, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["streams"], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"at": 100, "do": {"streamState": {"name": "example.now", "version": 1, "value": {"n": 1}}}},
    {"child": {"t": "stream.state", "body": {"name": "example.now", "version": 1, "value": {"n": 1}}}},
    {"at": 200, "do": {"streamEvent": {"id": "evt_1", "name": "example.happened", "version": 1, "body": {"n": 1}}}},
    {"child": {"t": "stream.event", "id": "evt_1", "body": {"name": "example.happened", "version": 1, "body": {"n": 1}}}},
    {"at": 300, "host": {"t": "ping"}},
    {"child": {"t": "pong"}},
    {"at": 400, "host": {"t": "stream.state", "body": {"name": "example.now", "version": 1, "at": 1760140800400, "value": {}}}},
    {"at": 500, "host": {"t": "stream.event", "id": "evt_h1", "body": {"name": "example.happened", "version": 1, "at": 1760140800500, "body": {}}}},
    {"child": {"t": "ack"}},
    {"at": 600, "do": {"streamEvent": {"id": "evt_x", "name": "link.dropped", "version": 1, "body": {"t": "mood", "reason": "bad_frame"}}}},
    {"deliver": {"kind": "unsent", "t": "stream.event", "code": "bad_frame", "id": "evt_x"}},
    {"at": 1000, "do": "disconnect"},
    {"at": 1100, "do": {"streamState": {"name": "example.now", "version": 1, "value": {"n": 2}}}},
    {"at": 1200, "do": {"streamEvent": {"id": "evt_2", "name": "example.happened", "version": 1, "body": {"n": 2}}}},
    {"at": 2000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 2050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": [], "turns": [], "serverTime": 1760140802050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"at": 2100, "do": {"streamState": {"name": "example.now", "version": 1, "value": {"n": 3}}}},
    {"at": 3000, "do": "disconnect"},
    {"at": 4000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 4050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["streams"], "turns": [], "serverTime": 1760140804050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "stream.event", "id": "evt_2", "body": {"body": {"n": 2}}}}
  ]
}

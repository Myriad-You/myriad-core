{
  "version": 1,
  "name": "called-lost",
  "about": "An end that was restarted with calls in hand does none of them again. Its shell wrote each call down before it began and hands them back; each is answered unknown, and asked or cancelled again under that id is answered unknown again and never handed to the shell. A call under a new id is a new decision of her host's.",
  "capabilities": ["calls"],
  "offers": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}],
  "steps": [
    {"at": 0, "do": {"callsLost": [{"callId": "call_look_1", "action": "screen.look", "version": 1}, {"callId": "call_work_1", "action": "work.run", "version": 1}]}},
    {"at": 100, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 150, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760140800150, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"child": {"t": "call.result", "id": "call_look_1.result", "body": {"callId": "call_look_1", "action": "screen.look", "version": 1, "outcome": "unknown", "result": "$absent", "error": "$absent"}, "seq": 3}},
    {"child": {"t": "call.result", "id": "call_work_1.result", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "outcome": "unknown"}, "seq": 4}},
    {"at": 150, "host": {"t": "call.ask", "id": "call_work_1", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "args": {"proposalId": "p_1", "title": "t", "instruction": "i"}, "for": {"kind": "owner"}, "deadlineAt": 1760141400000}}},
    {"deliver": {"kind": "call_settled", "callId": "call_look_1"}},
    {"deliver": {"kind": "call_settled", "callId": "call_work_1"}},
    {"child": {"t": "ack"}},
    {"child": {"t": "call.result", "id": "call_work_1.result", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "outcome": "unknown"}}},
    {"at": 200, "host": {"t": "call.granted", "body": {"actions": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}], "providing": []}}},
    {"deliver": {"kind": "call_settled", "callId": "call_work_1"}},
    {"deliver": {"kind": "granted"}},
    {"at": 1000, "host": {"t": "call.ask", "id": "call_look_1", "body": {"callId": "call_look_1", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760140809000}}},
    {"child": {"t": "ack"}},
    {"child": {"t": "call.result", "id": "call_look_1.result", "body": {"callId": "call_look_1", "action": "screen.look", "version": 1, "outcome": "unknown"}}},
    {"at": 1100, "host": {"t": "call.cancel", "body": {"callId": "call_work_1"}}},
    {"deliver": {"kind": "call_settled", "callId": "call_look_1"}},
    {"child": {"t": "call.result", "id": "call_work_1.result", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "outcome": "unknown"}}},
    {"at": 2000, "host": {"t": "call.ask", "id": "call_look_9", "body": {"callId": "call_look_9", "action": "screen.look", "version": 1, "args": {}, "for": {"kind": "owner"}, "deadlineAt": 1760140809000}}},
    {"deliver": {"kind": "call_settled", "callId": "call_work_1"}},
    {"child": {"t": "ack"}},
    {"deliver": {"kind": "call", "callId": "call_look_9"}},
    {"at": 2100, "do": {"callDone": {"callId": "call_look_9", "result": {"facts": {"app": "Xcode"}, "summary": "Xcode"}}}},
    {"child": {"t": "call.result", "id": "call_look_9.result", "body": {"callId": "call_look_9", "action": "screen.look", "version": 1, "outcome": "done"}}},
    {"at": 3000, "do": {"callsLost": [{"callId": "call_look_9", "action": "screen.look", "version": 1}]}},
    {"deliver": {"kind": "unsent", "t": "call.result", "code": "bad_id", "id": "call_look_9"}}
  ]
}

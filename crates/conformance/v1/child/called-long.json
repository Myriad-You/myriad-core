{
  "version": 1,
  "name": "called-long",
  "about": "A long action is said to be in hand at once (call.accepted), and again when it is asked again while in hand. Where it is (call.progress) and the pieces of its result (call.event, numbered from 1) go while the link is up and are let go while it is down; its result waits for the link and goes once. call.cancel stops a call in hand and answers call_cancelled; for one already answered it is answered as before, for one this end never had, nothing.",
  "capabilities": ["calls"],
  "offers": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}],
  "steps": [
    {"at": 0, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 50, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760140800050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"at": 60, "host": {"t": "call.granted", "body": {"actions": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}], "providing": []}}},
    {"deliver": {"kind": "granted"}},
    {"at": 1000, "host": {"t": "call.ask", "id": "call_work_1", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "args": {"proposalId": "p_1", "title": "t", "instruction": "i"}, "for": {"kind": "owner"}, "deadlineAt": 1760141400000}}},
    {"child": {"t": "ack", "seq": 3}},
    {"deliver": {"kind": "call", "callId": "call_work_1", "action": "work.run"}},
    {"child": {"t": "call.accepted", "seq": 4, "body": {"callId": "call_work_1"}}},
    {"at": 1500, "host": {"t": "call.ask", "id": "call_work_1", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "args": {"proposalId": "p_1", "title": "t", "instruction": "i"}, "for": {"kind": "owner"}, "deadlineAt": 1760141400000}}},
    {"child": {"t": "ack"}},
    {"child": {"t": "call.accepted", "body": {"callId": "call_work_1"}}},
    {"at": 2000, "do": {"callProgress": {"callId": "call_work_1", "phase": "confirming", "waiting": true}}},
    {"child": {"t": "call.progress", "body": {"callId": "call_work_1", "phase": "confirming", "waiting": "owner"}}},
    {"at": 3000, "do": {"callProgress": {"callId": "call_work_1", "phase": "running"}}},
    {"child": {"t": "call.progress", "body": {"callId": "call_work_1", "phase": "running", "waiting": "$absent"}}},
    {"at": 3500, "do": {"callPiece": {"callId": "call_work_1", "piece": "one"}}},
    {"child": {"t": "call.event", "body": {"callId": "call_work_1", "sequence": 1, "piece": "one"}}},
    {"at": 3600, "do": {"callPiece": {"callId": "call_work_1", "piece": "two"}}},
    {"child": {"t": "call.event", "body": {"sequence": 2}}},
    {"at": 4000, "do": "disconnect"},
    {"at": 4100, "do": {"callProgress": {"callId": "call_work_1", "phase": "running"}}},
    {"at": 4150, "do": {"callPiece": {"callId": "call_work_1", "piece": "three"}}},
    {"at": 4200, "do": {"callDone": {"callId": "call_work_1", "result": {"status": "completed"}}}},
    {"at": 5000, "do": "connect"},
    {"child": {"t": "hello", "seq": 1}},
    {"at": 5050, "host": {"t": "welcome", "body": {"protocol": 2, "role": "host", "host": "site", "deviceId": "dev_0123456789abcdef0123456789abcdef", "heartbeatMs": 15000, "capabilities": ["calls"], "turns": [], "serverTime": 1760140805050, "sync": "off"}}},
    {"deliver": {"kind": "welcome"}},
    {"child": {"t": "call.offer", "seq": 2}},
    {"child": {"t": "call.result", "id": "call_work_1.result", "body": {"callId": "call_work_1", "action": "work.run", "version": 1, "outcome": "done", "result": {"status": "completed"}}, "seq": 3}},
    {"at": 5060, "host": {"t": "call.granted", "body": {"actions": [{"name": "notify.post", "version": 1}, {"name": "screen.look", "version": 1}, {"name": "work.run", "version": 1}], "providing": []}}},
    {"deliver": {"kind": "call_settled", "callId": "call_work_1"}},
    {"deliver": {"kind": "granted"}},
    {"at": 6000, "host": {"t": "call.ask", "id": "call_work_2", "body": {"callId": "call_work_2", "action": "work.run", "version": 1, "args": {"proposalId": "p_1", "title": "t", "instruction": "i"}, "for": {"kind": "owner"}, "deadlineAt": 1760141400000}}},
    {"child": {"t": "ack"}},
    {"deliver": {"kind": "call", "callId": "call_work_2"}},
    {"child": {"t": "call.accepted", "body": {"callId": "call_work_2"}}},
    {"at": 7000, "host": {"t": "call.cancel", "body": {"callId": "call_work_2"}}},
    {"deliver": {"kind": "call_stop", "callId": "call_work_2", "why": "cancelled"}},
    {"child": {"t": "call.result", "id": "call_work_2.result", "body": {"callId": "call_work_2", "action": "work.run", "version": 1, "outcome": "failed", "error": {"code": "call_cancelled"}}}},
    {"at": 7100, "host": {"t": "call.cancel", "body": {"callId": "call_work_2"}}},
    {"deliver": {"kind": "call_settled", "callId": "call_work_2"}},
    {"child": {"t": "call.result", "id": "call_work_2.result", "body": {"callId": "call_work_2", "action": "work.run", "version": 1, "outcome": "failed", "error": {"code": "call_cancelled"}}}},
    {"at": 7200, "host": {"t": "call.cancel", "body": {"callId": "call_never"}}},
    {"deliver": {"kind": "call_settled", "callId": "call_work_2"}},
    {"at": 7300, "do": {"callFailed": {"callId": "call_work_2", "code": "declined"}}},
    {"deliver": {"kind": "unsent", "t": "call.result", "code": "bad_id", "id": "call_work_2"}},
    {"at": 8000, "do": "disconnect"}
  ]
}
